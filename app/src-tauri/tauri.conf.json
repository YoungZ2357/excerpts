{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excerpts",
  "version": "0.1.0",
  "identifier": "io.github.YoungZ2357.excerpts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Excerpts",
        "width": 400,
        "height": 300,
        "resizable": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "YoungZ2357",
    "shortDescription": "在桌面卡片上随机显示一句摘抄",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
